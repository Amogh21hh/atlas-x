# Copy the keys you need into the app's Secrets box on Streamlit Community Cloud
# (App → Settings → Secrets), or into .streamlit/secrets.toml for local runs.
# NEVER commit a real secrets.toml: it is listed in .gitignore.
# All keys are optional. Without ATLAS_ADMIN_PASSWORD the dashboard is read-only.

# Password for the admin controls (run cycle, kill switch, mandate). At least 12 characters.
ATLAS_ADMIN_PASSWORD = "replace-with-a-long-random-password"

# Minutes between automatic paper cycles triggered by page visits (0 disables). Default 15.
ATLAS_AUTO_CYCLE_MINUTES = "15"

# Starting cash of the simulated paper account, in GBP. Default 100000.
ATLAS_PAPER_CASH = "100000"

# Optional webhook for warnings (Slack/Discord/ntfy-compatible JSON). Leave empty to disable.
ATLAS_NOTIFY_WEBHOOK = ""
